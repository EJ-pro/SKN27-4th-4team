# ── Database ──────────────────────────────────────
DB_HOST=db
DB_PORT=5432
DB_NAME=postgresdb
DB_USER=postgres
DB_PASSWORD=password

# ── Django ────────────────────────────────────────
SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── OpenAI (임베딩 / LLM) ─────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5-nano

# ── LLM provider (에픽 04 — Django 챗봇·RAG) ─────
# openai | remote (RunPod OpenAI 호환)
LLM_PROVIDER=openai
EMBEDDING_PROVIDER=openai

# RunPod OpenAI 호환 /v1 — provider=remote 일 때만 설정
# REMOTE_LLM_BASE_URL=https://your-pod.proxy.runpod.net/v1
# REMOTE_LLM_MODEL=your-chat-model
# REMOTE_EMBEDDING_MODEL=text-embedding-3-small
# REMOTE_API_KEY=

# ── LLM 인증 게이트 (에픽 03) ───────────────────
CHATBOT_REQUIRE_AUTH=False

# ── AI 루틴 추천 (recommendation_service) ───────
# recommendation_service/config.py 도 LLM_PROVIDER env 사용 (기본 openai)
# 속도 비교나 로컬 테스트가 필요할 때만 groq/ollama로 임시 변경
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.1-8b-instant

# Optional local Ollama provider
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=test1234
NEO4J_AUTH=neo4j/test1234

# Optional limits
MAX_SUPERVISOR_STEPS=24

# LangSmith (optional)
LANGCHAIN_TRACING_V2="false"
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_PROJECT="Modular RAG TUTORIAL"
LANGCHAIN_API_KEY=...
