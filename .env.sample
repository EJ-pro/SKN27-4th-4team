# ── Database ──────────────────────────────────────
DB_HOST=db
DB_PORT=5432
DB_NAME=postgresdb
DB_USER=postgres
DB_PASSWORD=password

# ── Django ────────────────────────────────────────
SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── OpenAI (임베딩 / LLM) ─────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5-nano

# LLM
LLM_PROVIDER=openai
EMBEDDING_PROVIDER=openai
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.1-8b-instant

# Optional local Ollama provider
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=test1234
NEO4J_AUTH=neo4j/test1234

# Optional limits
MAX_SUPERVISOR_STEPS=24

# LangSmith (optional)
LANGCHAIN_TRACING_V2="false"
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_PROJECT="Modular RAG TUTORIAL"
LANGCHAIN_API_KEY=...


# ── LLM 인증 게이트 (에픽 03) ───────────────────
# False(기본): 게스트도 LLM 사용 가능
# True: 로그인 + 유효 JWT(access_token) 있을 때만 LLM 실행
CHATBOT_REQUIRE_AUTH=False

# RunPod OpenAI 호환 /v1 — Step 2 구축 후 provider=remote 로 전환할 때만 설정
# REMOTE_LLM_BASE_URL=https://your-pod.proxy.runpod.net/v1
# REMOTE_LLM_MODEL=your-chat-model
# REMOTE_EMBEDDING_MODEL=text-embedding-3-small
# REMOTE_API_KEY=
