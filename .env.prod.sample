# Copy this file to .env.prod on the EC2 server and replace every placeholder.

# Database
DB_HOST=db
DB_PORT=5432
DB_NAME=routinegraph
DB_USER=routinegraph
DB_PASSWORD=replace-with-a-long-random-password

# Django
SECRET_KEY=replace-with-a-long-random-django-secret
DEBUG=False
ALLOWED_HOSTS=your-domain.com,www.your-domain.com,EC2_PUBLIC_IP
CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com
CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://www.your-domain.com
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# Frontend build. Leave empty to call /api on the same domain.
VITE_API_URL=
HTTP_PORT=80

# OpenAI / LLM
OPENAI_API_KEY=replace-with-your-openai-key
OPENAI_MODEL=gpt-5-nano
LLM_PROVIDER=openai
EMBEDDING_PROVIDER=openai
GROQ_API_KEY=
GROQ_MODEL=

# Optional local Ollama provider
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-a-long-random-neo4j-password
NEO4J_AUTH=neo4j/replace-with-a-long-random-neo4j-password
NEO4J_HEAP_INITIAL=512m
NEO4J_HEAP_MAX=2G
NEO4J_PAGECACHE=1G

# Runtime limits
MAX_SUPERVISOR_STEPS=24
CHATBOT_REQUIRE_AUTH=False
CHATBOT_ENABLE_RERANK=False
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=180

# LangSmith optional
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_PROJECT=RoutineGraph
LANGCHAIN_API_KEY=
